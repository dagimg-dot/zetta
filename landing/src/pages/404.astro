---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
---

<Base title="Page not found · zetta" description="This page does not exist on the zetta site." noindex>
	<main class="lost">
		<Logo size={56} />
		<h1>That page is not here.</h1>
		<p>It may have moved. The rest of zetta is one click away.</p>
		<a class="btn btn-primary" href="/">Go to the zetta site</a>
	</main>
</Base>

<style>
	.lost {
		min-height: 100dvh;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 20px;
		padding: 24px;
		text-align: center;
	}

	h1 {
		margin: 12px 0 0;
		font-size: clamp(28px, 4vw, 40px);
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	p {
		margin: 0 0 8px;
		color: var(--fg-2);
	}

	.btn {
		padding-right: 22px;
	}
</style>
