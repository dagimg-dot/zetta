---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	/** The app in its light theme, shown on the dark page. */
	light: ImageMetadata;
	/** The app in its dark theme, shown on the light page. */
	dark: ImageMetadata;
	alt: string;
	/** For the first screenshot on the page, which is the largest paint. */
	eager?: boolean;
	class?: string;
}

const { light, dark, alt, eager = false, class: cls } = Astro.props;
const widths = [720, 1200, 1800, 2400];
const sizes = "(max-width: 1240px) calc(100vw - 32px), 1200px";
const [onDark, onLight] = await Promise.all([
	getImage({ src: light, widths, format: "webp" }),
	getImage({ src: dark, widths, format: "webp" }),
]);
---

{/*
 * One picture, so each visitor downloads one image. The source follows the OS theme; when
 * the page overrides it, Base.astro rewrites the source's media to match.
 */}
<picture class={cls}>
	<source media="(prefers-color-scheme: dark)" srcset={onDark.srcSet.attribute} sizes={sizes} data-dark-page />
	<img
		src={onLight.src}
		srcset={onLight.srcSet.attribute}
		sizes={sizes}
		alt={alt}
		width={dark.width}
		height={dark.height}
		loading={eager ? "eager" : "lazy"}
		fetchpriority={eager ? "high" : "auto"}
		decoding={eager ? "sync" : "async"}
	/>
</picture>
