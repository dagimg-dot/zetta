---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	/** The app in its light theme, shown on the dark page. */
	light: ImageMetadata;
	/** The app in its dark theme, shown on the light page. */
	dark: ImageMetadata;
	alt: string;
	eager?: boolean;
	class?: string;
}

const { light, dark, alt, eager = false, class: cls } = Astro.props;
const common = {
	alt,
	widths: [720, 1200, 1800, 2400],
	sizes: "(max-width: 1240px) 100vw, 1200px",
	loading: eager ? ("eager" as const) : ("lazy" as const),
};
---

<Image src={light} {...common} class:list={["for-dark-page", cls]} />
<Image src={dark} {...common} class:list={["for-light-page", cls]} />
