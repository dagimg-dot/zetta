---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { links } from "../site";

const items = [
	{ href: "#features", label: "Features" },
	{ href: "#shell", label: "Shell" },
	{ href: "#security", label: "Security" },
	{ href: "#install", label: "Install" },
];
---

<header class="nav-wrap">
	<nav class="nav" aria-label="Main">
		<a href="#top" class="brand" aria-label="zetta home">
			<Logo size={26} />
			<span>zetta</span>
		</a>
		<ul class="links">
			{
				items.map((i) => (
					<li>
						<a href={i.href}>{i.label}</a>
					</li>
				))
			}
		</ul>
		<button class="icon-btn theme" aria-label="Switch between light and dark">
			<Icon name="sun" size={17} class="for-dark-page" />
			<Icon name="moon" size={17} class="for-light-page" />
		</button>
		<a href={links.repo} class="gh" target="_blank" rel="noopener">
			<Icon name="github" size={16} />
			<span>GitHub</span>
		</a>
		<button class="icon-btn burger" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
			<span></span><span></span>
		</button>
	</nav>
</header>

<div class="menu" id="menu" aria-hidden="true">
	<ul>
		{
			[...items, { href: links.repo, label: "GitHub" }].map((i, n) => (
				<li style={`--i:${n}`}>
					<a href={i.href}>{i.label}</a>
				</li>
			))
		}
	</ul>
</div>

<script>
	const root = document.documentElement;
	const burger = document.querySelector<HTMLButtonElement>(".burger");
	const menu = document.querySelector<HTMLElement>(".menu");
	const header = document.querySelector<HTMLElement>(".nav-wrap");
	const osDark = matchMedia("(prefers-color-scheme: dark)");

	document.querySelector(".theme")?.addEventListener("click", () => {
		const current = root.dataset.theme ?? (osDark.matches ? "dark" : "light");
		const next = current === "dark" ? "light" : "dark";
		const followsOs = next === (osDark.matches ? "dark" : "light");
		if (followsOs) delete root.dataset.theme;
		else root.dataset.theme = next;
		try {
			if (followsOs) localStorage.removeItem("zetta-site.theme");
			else localStorage.setItem("zetta-site.theme", next);
		} catch {
			// Storage can be blocked; the choice then lasts for this page only.
		}
	});

	function setMenu(open: boolean) {
		if (!burger || !menu) return;
		document.body.classList.toggle("menu-open", open);
		burger.setAttribute("aria-expanded", String(open));
		burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		menu.setAttribute("aria-hidden", String(!open));
	}

	burger?.addEventListener("click", () => setMenu(!document.body.classList.contains("menu-open")));
	for (const a of menu?.querySelectorAll("a") ?? []) a.addEventListener("click", () => setMenu(false));
	addEventListener("keydown", (e) => {
		if (e.key === "Escape") setMenu(false);
	});

	const top = document.querySelector("#top");
	if (top && header) {
		new IntersectionObserver(([e]) => header.classList.toggle("scrolled", !e.isIntersecting), {
			rootMargin: "-80px 0px 0px 0px",
		}).observe(top);
	}
</script>

<style>
	.nav-wrap {
		position: fixed;
		inset: 20px 0 auto;
		z-index: var(--z-nav);
		display: flex;
		justify-content: center;
		padding-inline: 16px;
		pointer-events: none;
	}

	.nav {
		pointer-events: auto;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 6px 6px 6px 14px;
		border-radius: 999px;
		background: light-dark(oklch(1 0 0 / 0.72), oklch(0.17 0.004 50 / 0.6));
		backdrop-filter: blur(20px) saturate(160%);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		box-shadow:
			inset 0 0 0 1px var(--hair),
			inset 0 1px 0 var(--highlight),
			0 20px 40px -24px var(--shadow);
		transition: box-shadow 600ms var(--ease);
	}

	.nav-wrap:global(.scrolled) .nav {
		box-shadow:
			inset 0 0 0 1px var(--hair-2),
			inset 0 1px 0 var(--highlight),
			0 24px 48px -20px var(--shadow);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-right: 16px;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.links {
		display: flex;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		display: block;
		padding: 8px 14px;
		border-radius: 999px;
		font-size: 14px;
		color: var(--fg-2);
		transition:
			color 400ms var(--ease),
			background-color 400ms var(--ease);
	}

	.links a:hover {
		color: var(--fg);
		background: var(--tint);
	}

	.icon-btn {
		position: relative;
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 999px;
		color: var(--fg-2);
		transition:
			background-color 400ms var(--ease),
			color 400ms var(--ease);
	}

	.icon-btn:hover {
		background: var(--tint);
		color: var(--fg);
	}

	.theme {
		margin-left: 6px;
	}

	.gh {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 38px;
		padding: 0 16px;
		border-radius: 999px;
		font-size: 14px;
		background: var(--fg);
		color: var(--bg);
		transition: transform 500ms var(--ease);
	}

	.gh:active {
		transform: scale(0.96);
	}

	.burger {
		display: none;
		background: var(--tint);
	}

	.burger span {
		position: absolute;
		left: 11px;
		width: 16px;
		height: 1.5px;
		border-radius: 2px;
		background: var(--fg);
		transition: transform 600ms var(--ease);
	}

	.burger span:first-child {
		transform: translateY(-3.5px);
	}

	.burger span:last-child {
		transform: translateY(3.5px);
	}

	:global(.menu-open) .burger span:first-child {
		transform: rotate(45deg);
	}

	:global(.menu-open) .burger span:last-child {
		transform: rotate(-45deg);
	}

	.menu {
		position: fixed;
		inset: 0;
		z-index: var(--z-menu);
		display: flex;
		align-items: center;
		padding: 120px 28px 60px;
		background: light-dark(oklch(0.985 0.003 70 / 0.86), oklch(0.12 0.004 50 / 0.86));
		backdrop-filter: blur(40px);
		-webkit-backdrop-filter: blur(40px);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 600ms var(--ease),
			visibility 0s 600ms;
	}

	:global(.menu-open) .menu {
		opacity: 1;
		visibility: visible;
		transition: opacity 600ms var(--ease);
	}

	:global(.menu-open) .nav-wrap {
		z-index: calc(var(--z-menu) + 1);
	}

	.menu ul {
		display: grid;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.menu li {
		overflow: hidden;
	}

	.menu a {
		display: block;
		font-size: clamp(36px, 10vw, 56px);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 1.2;
		transform: translateY(100%);
		opacity: 0;
		transition:
			transform 800ms var(--ease),
			opacity 800ms var(--ease);
		transition-delay: calc(var(--i) * 55ms + 80ms);
	}

	:global(.menu-open) .menu a {
		transform: none;
		opacity: 1;
	}

	@media (max-width: 860px) {
		.links,
		.gh {
			display: none;
		}
		.burger {
			display: grid;
		}
		.brand {
			margin-right: auto;
		}
		.nav {
			width: 100%;
			max-width: 440px;
		}
	}
</style>
