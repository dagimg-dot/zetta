---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import Version from "./Version.astro";
import { installCmd, links } from "../site";

const year = new Date().getFullYear();
---

<section class="finale">
	<div class="wrap">
		<div class="shell cta reveal">
			<div class="core">
				<div class="mark" aria-hidden="true">
					{
						Array.from({ length: 16 }, (_, i) => (
							<i class:list={{ on: [0, 1, 2, 3, 6, 9, 12, 13, 14, 15].includes(i) }} style={`--i:${i}`} />
						))
					}
				</div>
				<h2 class="display">
					Open your database.<br /><span class="serif ember-text">Nothing else to install.</span>
				</h2>
				<p class="lede">Try it in this tab first, then install it in one line. Free and open source under MIT.</p>
				<div class="actions">
					<a class="btn btn-primary" href="/demo/">
						Try the live demo
						<span class="knob"><Icon name="arrow" size={16} /></span>
					</a>
					<button class="btn btn-ghost" data-copy={installCmd}>
						<span class="lbl">Copy install command</span>
						<span class="knob">
							<Icon name="copy" size={16} class="i-copy" />
							<Icon name="check" size={16} class="i-check" />
						</span>
					</button>
				</div>
			</div>
		</div>
	</div>

	<footer class="wrap foot">
		<div class="brand">
			<Logo size={22} />
			<span>zetta</span>
			<Version class="ver" />
		</div>
		<nav aria-label="Footer">
			<a href={links.repo} target="_blank" rel="noopener">GitHub</a>
			<a href={links.releases} target="_blank" rel="noopener">Releases</a>
			<a href={links.docker} target="_blank" rel="noopener">Docker Hub</a>
			<a href={links.issues} target="_blank" rel="noopener">Issues</a>
			<a href={links.license} target="_blank" rel="noopener">MIT License</a>
		</nav>
		<p>&copy; {year} zetta contributors</p>
	</footer>
</section>

<style>
	.finale {
		padding-top: var(--section);
	}

	.cta {
		--r-xl: 36px;
		--bezel: 8px;
	}

	.cta .core {
		display: grid;
		justify-items: center;
		gap: 28px;
		padding: clamp(56px, 9vw, 120px) clamp(20px, 5vw, 64px);
		text-align: center;
		background:
			radial-gradient(800px 420px at 50% 115%, var(--glow), transparent 70%),
			linear-gradient(180deg, var(--surface-top), var(--surface-bottom));
	}

	.cta .display {
		font-size: clamp(38px, 6vw, 80px);
	}

	.mark {
		display: grid;
		grid-template-columns: repeat(4, 14px);
		gap: 6px;
		padding: 16px;
		border-radius: 20px;
		background: var(--ember);
		box-shadow:
			inset 0 0 0 1px oklch(1 0 0 / 0.15),
			0 20px 60px -10px var(--glow);
	}

	.mark i {
		width: 14px;
		height: 14px;
		border-radius: 4px;
		background: #fff;
		opacity: 0.22;
		transform: scale(0.8);
	}

	.mark i.on {
		animation: light 3.6s var(--ease) infinite;
		animation-delay: calc(var(--i) * 90ms);
	}

	@keyframes light {
		0%,
		100% {
			opacity: 0.22;
			transform: scale(0.8);
		}
		25%,
		70% {
			opacity: 1;
			transform: none;
		}
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px 32px;
		padding-block: 56px 48px;
		font-size: 14px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 500;
	}

	.brand :global(.ver) {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-4);
	}

	.foot p {
		margin: 0;
		color: var(--fg-3);
	}

	.foot nav {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
	}

	.foot nav a {
		color: var(--fg-3);
		transition: color 400ms var(--ease);
	}

	.foot nav a:hover {
		color: var(--fg);
	}
</style>
