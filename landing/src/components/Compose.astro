---
import Icon from "./Icon.astro";
import { composeYaml } from "../site";

const points = [
	{ title: "Waits for your database", body: "It keeps trying for 30 seconds while the database starts, so it needs no health check." },
	{ title: "A 1.5 MB image", body: "A static binary on scratch for amd64 and arm64, pulled in a moment." },
	{ title: "Safe on a shared database", body: "Set ZETTA_READ_ONLY and the adapter refuses every write." },
];
---

<section class="section compose" id="compose">
	<div class="wrap split">
		<div class="text">
			<h2 class="h2 reveal">Add it to your <span class="file-name">docker-compose.yml.</span></h2>
			<p class="lede reveal" style="--d:1">
				Your dev database already runs in Compose. Put zetta beside it and every developer on the
				project gets a database UI with <code>docker compose up</code>.
			</p>
			<ul class="points">
				{
					points.map((p, i) => (
						<li class="reveal" style={`--d:${i + 2}`}>
							<b>{p.title}</b>
							<span>{p.body}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div class="file reveal" style="--d:2">
			<div class="shell">
				<div class="core">
					<div class="bar">
						<span class="dots"><i></i><i></i><i></i></span>
						<span class="name">docker-compose.yml</span>
						<button class="copy" data-copy={composeYaml} aria-label="Copy the compose file">
							<Icon name="copy" size={16} class="i-copy" />
							<Icon name="check" size={16} class="i-check" />
						</button>
					</div>
<pre><span class="k">services:</span>
  <span class="k">db:</span>
    <span class="k">image:</span> <span class="s">postgres:17</span>
    <span class="k">environment:</span>
      <span class="k">POSTGRES_PASSWORD:</span> <span class="s">postgres</span>

  <span class="k hl">zetta:</span>
    <span class="k">image:</span> <span class="s">workflowjd/zetta</span>
    <span class="k">ports:</span> [<span class="s">"127.0.0.1:1993:1993"</span>]
    <span class="k">environment:</span>
      <span class="k">ZETTA_TOKEN:</span> <span class="v">{"${ZETTA_TOKEN}"}</span>
      <span class="k">DATABASE_URL:</span> <span class="s">postgres://postgres:postgres@db:5432/postgres</span>
    <span class="k">depends_on:</span> [<span class="s">db</span>]</pre>
					<p class="foot">
						Put a token from <code>openssl rand -hex 16</code> in <code>.env</code> as <code>ZETTA_TOKEN</code>,
						then open the link <code>docker compose logs zetta</code> prints.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.split {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(40px, 7vw, 104px);
		align-items: center;
	}

	.text {
		display: grid;
		gap: 24px;
		justify-items: start;
	}

	.file-name {
		white-space: nowrap;
	}

	.points {
		display: grid;
		width: 100%;
		margin: 8px 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--hair);
	}

	.points li {
		display: grid;
		gap: 4px;
		padding: 16px 0;
		border-bottom: 1px solid var(--hair);
	}

	.points b {
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.points span {
		font-size: 14.5px;
		color: var(--fg-3);
	}

	/* A file in an editor is dark whatever the page theme is. */
	.file .shell {
		--r-xl: 22px;
		color-scheme: dark;
		color: var(--fg);
		box-shadow:
			inset 0 0 0 1px var(--hair-2),
			0 60px 120px -40px light-dark(oklch(0.3 0.04 50 / 0.35), oklch(0 0 0 / 0.9)),
			0 0 140px -30px var(--wash);
	}

	.file .core {
		background: oklch(0.13 0.004 50);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 14px;
		height: 48px;
		padding: 0 8px 0 16px;
		border-bottom: 1px solid var(--hair);
	}

	.name {
		flex: 1;
		font-family: var(--font-mono);
		font-size: 12.5px;
		color: var(--fg-3);
	}

	.copy {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 10px;
		color: var(--fg-3);
		transition:
			background-color 400ms var(--ease),
			color 400ms var(--ease);
	}

	.copy:hover {
		background: var(--tint-2);
		color: var(--fg);
	}

	pre {
		margin: 0;
		padding: 22px 24px;
		font-size: 13.5px;
		line-height: 1.75;
		color: var(--fg-2);
		overflow-x: auto;
	}

	.k {
		color: var(--fg);
	}

	.k.hl {
		color: var(--accent);
	}

	.s {
		color: var(--syn-string);
	}

	.v {
		color: var(--syn-number);
	}

	.foot {
		margin: 0;
		padding: 14px 24px 18px;
		border-top: 1px solid var(--hair);
		font-size: 13.5px;
		color: var(--fg-3);
	}

	.foot code,
	.lede code {
		font-size: 0.92em;
		color: var(--fg-2);
	}

	@media (max-width: 960px) {
		.split {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 560px) {
		pre {
			font-size: 12px;
			padding: 18px 16px;
		}
	}
</style>
