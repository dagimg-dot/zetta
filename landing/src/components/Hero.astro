---
import Icon from "./Icon.astro";
import Screenshot from "./Screenshot.astro";
import { installCmd, links, version } from "../site";
import { screens } from "../screens";
---

<section class="hero" id="top">
	<div class="backdrop" aria-hidden="true"></div>

	<div class="wrap intro">
		<a class="release reveal" href={links.releases} target="_blank" rel="noopener">
			<span class="tag">v{version}</span>
			Postgres and SQLite, MIT licensed
			<Icon name="arrow" size={14} />
		</a>

		<h1 class="display reveal" style="--d:1">
			A database explorer<br />
			that fits in <span class="serif ember-text">three&nbsp;megabytes.</span>
		</h1>

		<p class="lede reveal" style="--d:2">
			Point zetta at Postgres or SQLite. Browse and query in your browser, or run SQL from the
			shell. It is one binary with its own Postgres client, TLS and SQLite inside.
		</p>

		<div class="actions reveal" style="--d:3">
			<div class="cmd">
				<span class="prompt">$</span>
				<code>curl -fsSL <span class="dim">…/zetta/main/</span>install.sh | sh</code>
				<button class="copy" data-copy={installCmd} aria-label="Copy the install command">
					<Icon name="copy" size={16} class="i-copy" />
					<Icon name="check" size={16} class="i-check" />
				</button>
			</div>
			<a class="btn btn-ghost" href={links.repo} target="_blank" rel="noopener">
				View on GitHub
				<span class="knob"><Icon name="arrow" size={16} /></span>
			</a>
		</div>
	</div>

	<div class="wrap stage">
		<div class="window shell reveal" style="--d:4">
			<div class="core">
				<div class="chrome">
					<span class="dots"><i></i><i></i><i></i></span>
					<span class="url">
						<Icon name="lock" size={12} />
						127.0.0.1:1993
					</span>
					<span class="dots spacer" aria-hidden="true"></span>
				</div>
				<Screenshot {...screens.postgres} eager class="shot" />
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding-top: clamp(140px, 17vw, 196px);
		isolation: isolate;
	}

	.backdrop {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		background-image:
			linear-gradient(to right, var(--hair) 1px, transparent 1px),
			linear-gradient(to bottom, var(--hair) 1px, transparent 1px);
		background-size: 64px 64px;
		background-position: center top;
		mask-image: radial-gradient(ellipse 70% 50% at 50% 20%, #000 10%, transparent 75%);
	}

	.backdrop::after {
		content: "";
		position: absolute;
		left: 50%;
		top: 52%;
		width: min(1400px, 140vw);
		aspect-ratio: 2.2;
		transform: translateX(-50%);
		background: radial-gradient(closest-side, var(--glow), transparent 70%);
		filter: blur(40px);
	}

	.intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 28px;
	}

	.release {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 4px 14px 4px 4px;
		border-radius: 999px;
		background: var(--tint);
		box-shadow:
			inset 0 0 0 1px var(--hair),
			inset 0 1px 0 var(--highlight);
		font-size: 13px;
		color: var(--fg-2);
		transition: background-color 400ms var(--ease);
	}

	.release:hover {
		background: var(--tint-2);
	}

	.tag {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--ember);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 8px;
	}

	.cmd {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
		height: 52px;
		padding: 0 6px 0 20px;
		border-radius: 999px;
		background: var(--surface-top);
		box-shadow:
			inset 0 0 0 1px var(--hair-2),
			0 12px 40px -16px var(--shadow);
		font-size: 14px;
	}

	.cmd code {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.prompt {
		font-family: var(--font-mono);
		color: var(--accent);
	}

	.dim {
		color: var(--fg-3);
	}

	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		background: var(--tint);
		color: var(--fg-2);
		transition:
			background-color 400ms var(--ease),
			transform 400ms var(--ease);
	}

	.copy:hover {
		background: var(--tint-2);
		color: var(--fg);
	}

	.copy:active {
		transform: scale(0.92);
	}

	.stage {
		margin-top: clamp(56px, 7vw, 96px);
		perspective: 2000px;
	}

	.window {
		--r-xl: 22px;
		--bezel: 7px;
		max-width: 1200px;
		margin-inline: auto;
		box-shadow:
			inset 0 0 0 1px var(--hair-2),
			0 60px 120px -40px var(--shadow),
			0 0 120px -20px var(--wash);
		transform-origin: 50% 0%;
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.window.in {
				animation: tilt linear both;
				animation-timeline: view();
				animation-range: entry 0% cover 45%;
			}
		}
	}

	@keyframes tilt {
		from {
			transform: rotateX(20deg) scale(0.93) translateY(24px);
		}
		to {
			transform: none;
		}
	}

	.chrome {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		height: 42px;
		padding: 0 14px;
		border-bottom: 1px solid var(--hair);
	}

	.spacer {
		width: 44px;
	}

	.url {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 4px 14px;
		border-radius: 8px;
		background: var(--tint);
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-3);
	}

	.window :global(.shot) {
		width: 100%;
		height: auto;
	}

	@media (max-width: 760px) {
		.window {
			--r-xl: 16px;
			--bezel: 4px;
		}
		.actions,
		.cmd {
			width: 100%;
		}
	}
</style>
