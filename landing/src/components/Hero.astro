---
import Icon from "./Icon.astro";
import Screenshot from "./Screenshot.astro";
import Tilt from "./Tilt.astro";
import Version from "./Version.astro";
import { dockerCmd, installCmd, links } from "../site";
import { screens } from "../screens";
---

<section class="hero" id="top">
	<div class="backdrop" aria-hidden="true"></div>

	<div class="wrap intro">
		<a class="release reveal" href={links.releases} target="_blank" rel="noopener">
			<Version class="tag" />
			Try the latest release
			<Icon name="arrow" size={14} />
		</a>

		<h1 class="display reveal" style="--d:1">
			Your database,<br />
			in a <span class="serif ember-text">browser&nbsp;tab.</span>
		</h1>

		<p class="lede reveal" style="--d:2">
			One <code>docker run</code> or one binary under 3&nbsp;MB. Postgres and SQLite, nothing else to
			install.
		</p>

		<div class="try reveal" style="--d:3">
			<div class="switch" role="tablist" aria-label="How to run zetta">
				<button role="tab" id="try-tab-docker" aria-controls="try-docker" aria-selected="true">
					Docker
				</button>
				<button role="tab" id="try-tab-script" aria-controls="try-script" aria-selected="false">
					Install script
				</button>
			</div>

			<div class="actions">
				<div class="cmd" role="tabpanel" id="try-docker" aria-labelledby="try-tab-docker">
					<span class="prompt">$</span>
					<code>docker run <span class="dim">…</span> -e DATABASE_URL=<span class="dim">…</span> workflowjd/zetta</code>
					<button class="copy" data-copy={dockerCmd} aria-label="Copy the docker run command">
						<Icon name="copy" size={16} class="i-copy" />
						<Icon name="check" size={16} class="i-check" />
					</button>
				</div>
				<div class="cmd" role="tabpanel" id="try-script" aria-labelledby="try-tab-script" hidden>
					<span class="prompt">$</span>
					<code>curl -fsSL <span class="dim">…/zetta/main/</span>install.sh | sh</code>
					<button class="copy" data-copy={installCmd} aria-label="Copy the install command">
						<Icon name="copy" size={16} class="i-copy" />
						<Icon name="check" size={16} class="i-check" />
					</button>
				</div>
				<a class="btn btn-primary" href="/demo/">
					Try the live demo
					<span class="knob"><Icon name="arrow" size={16} /></span>
				</a>
			</div>

			<p class="hint" data-for="try-docker">
				Set your database URL, run it, then open the localhost link it prints.
			</p>
			<p class="hint" data-for="try-script" hidden>
				Then open any database with <code>zetta app.db</code> or a <code>postgres://</code> URL.
			</p>
		</div>
	</div>

	<div class="wrap stage">
		<Tilt>
			<div class="window shell reveal" style="--d:4">
				<div class="core">
					<div class="chrome">
						<span class="dots"><i></i><i></i><i></i></span>
						<span class="url">
							<Icon name="lock" size={12} />
							127.0.0.1:1993
						</span>
						<span class="dots spacer" aria-hidden="true"></span>
					</div>
					<Screenshot {...screens.postgres} eager class="shot" />
				</div>
			</div>
		</Tilt>
	</div>
</section>

<script>
	const tabs = [...document.querySelectorAll<HTMLButtonElement>(".try [role=tab]")];
	for (const tab of tabs) {
		tab.addEventListener("click", () => {
			for (const t of tabs) {
				const on = t === tab;
				const id = t.getAttribute("aria-controls") ?? "";
				t.setAttribute("aria-selected", String(on));
				for (const el of document.querySelectorAll<HTMLElement>(`#${id}, .hint[data-for="${id}"]`)) {
					el.hidden = !on;
				}
			}
		});
	}
</script>

<style>
	.hero {
		position: relative;
		padding-top: clamp(140px, 17vw, 196px);
		isolation: isolate;
	}

	.backdrop {
		position: absolute;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		background-image:
			linear-gradient(to right, var(--hair) 1px, transparent 1px),
			linear-gradient(to bottom, var(--hair) 1px, transparent 1px);
		background-size: 64px 64px;
		background-position: center top;
		mask-image: radial-gradient(ellipse 70% 50% at 50% 20%, #000 10%, transparent 75%);
	}

	.backdrop::after {
		content: "";
		position: absolute;
		left: 50%;
		top: 52%;
		width: min(1400px, 140vw);
		aspect-ratio: 2.2;
		transform: translateX(-50%);
		background: radial-gradient(closest-side, var(--glow), transparent 70%);
		filter: blur(40px);
	}

	.intro .lede {
		text-wrap: balance;
	}

	.intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 28px;
	}

	.release {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 4px 14px 4px 4px;
		border-radius: 999px;
		background: var(--tint);
		box-shadow:
			inset 0 0 0 1px var(--hair),
			inset 0 1px 0 var(--highlight);
		font-size: 13px;
		color: var(--fg-2);
		transition: background-color 400ms var(--ease);
	}

	.release:has(.tag[hidden]) {
		padding-left: 14px;
	}

	.release:hover {
		background: var(--tint-2);
	}

	.release :global(.tag) {
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--ember);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 500;
	}

	.try {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		max-width: 100%;
		margin-top: 8px;
	}

	.try > * {
		max-width: 100%;
	}

	.switch {
		display: flex;
		gap: 2px;
		padding: 3px;
		border-radius: 999px;
		background: var(--tint);
		box-shadow: inset 0 0 0 1px var(--hair);
	}

	.switch button {
		padding: 5px 14px;
		border-radius: 999px;
		font-size: 13px;
		color: var(--fg-3);
		transition:
			background-color 400ms var(--ease),
			color 400ms var(--ease);
	}

	.switch button:hover {
		color: var(--fg);
	}

	.switch button[aria-selected="true"] {
		background: var(--raised);
		box-shadow:
			inset 0 0 0 1px var(--hair),
			0 1px 3px var(--shadow);
		color: var(--fg);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
	}

	.cmd[hidden] {
		display: none;
	}

	.cmd:not([hidden]) {
		animation: rise 400ms var(--ease-out);
	}

	.hint {
		margin: 0;
		font-size: 13.5px;
		color: var(--fg-3);
	}

	.hint code {
		font-size: 0.92em;
		color: var(--fg-2);
	}

	.cmd {
		width: 530px;
		max-width: 100%;
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
		height: 52px;
		padding: 0 6px 0 20px;
		border-radius: 999px;
		background: var(--surface-top);
		box-shadow:
			inset 0 0 0 1px var(--hair-2),
			0 12px 40px -16px var(--shadow);
		font-size: 14px;
	}

	.cmd code {
		flex: 1;
		min-width: 0;
		text-align: left;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.prompt {
		font-family: var(--font-mono);
		color: var(--accent);
	}

	.dim {
		color: var(--fg-3);
	}

	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 999px;
		background: var(--tint);
		color: var(--fg-2);
		transition:
			background-color 400ms var(--ease),
			transform 400ms var(--ease);
	}

	.copy:hover {
		background: var(--tint-2);
		color: var(--fg);
	}

	.copy:active {
		transform: scale(0.92);
	}

	.stage {
		margin-top: clamp(56px, 7vw, 96px);
	}

	.window {
		--r-xl: 22px;
		--bezel: 7px;
		max-width: 1200px;
		margin-inline: auto;
		box-shadow:
			inset 0 0 0 1px var(--hair-2),
			0 60px 120px -40px var(--shadow),
			0 0 120px -20px var(--wash);
		transform-origin: 50% 0%;
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.window.in {
				animation: tilt linear both;
				animation-timeline: view();
				animation-range: entry 0% cover 45%;
			}
		}
	}

	@keyframes tilt {
		from {
			transform: rotateX(20deg) scale(0.93) translateY(24px);
		}
		to {
			transform: none;
		}
	}

	.chrome {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		height: 42px;
		padding: 0 14px;
		border-bottom: 1px solid var(--hair);
	}

	.spacer {
		width: 44px;
	}

	.url {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 4px 14px;
		border-radius: 8px;
		background: var(--tint);
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-3);
	}

	.window :global(.shot) {
		width: 100%;
		height: auto;
	}

	@media (max-width: 760px) {
		.window {
			--r-xl: 16px;
			--bezel: 4px;
		}
		.try,
		.actions,
		.cmd {
			width: 100%;
		}
	}
</style>
