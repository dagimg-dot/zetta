---
import Icon from "./Icon.astro";

const items = [
	{
		icon: "server",
		title: "Loopback and a fresh token",
		body: "<code>serve</code> listens on <code>127.0.0.1</code> with a new one-time token each run. A non-loopback host is refused unless you pass both <code>--token</code> and <code>--allow-plain-http</code>.",
	},
	{
		icon: "shield",
		title: "Hosts and origins checked",
		body: "A Host that is not an IP, localhost or on your <code>--allowed-hosts</code> list is refused, and so is any API call from another origin. The page's CSP allows inline code only by hash.",
	},
	{
		icon: "lock",
		title: "Read-only where it counts",
		body: "<code>--read-only</code> is enforced inside the database adapter, not the UI. SQLite opens the file read-only; Postgres runs each statement in a read-only transaction and refuses <code>DO</code> and <code>CALL</code>.",
	},
	{
		icon: "key",
		title: "Secrets stay secret",
		body: "Tokens, cookies and passwords never reach a log, and the password in any DSN is redacted before it is printed.",
	},
] as const;
---

<section class="section" id="security">
	<div class="wrap split">
		<div class="side">
			<h2 class="h2 reveal">Local by default.</h2>
			<p class="lede reveal" style="--d:1">
				An explorer holds the keys to your data, so zetta treats the browser tab as a guest rather
				than a trusted client.
			</p>
		</div>

		<ol class="list">
			{
				items.map((it, i) => (
					<li class="reveal" style={`--d:${i}`}>
						<h3>
							<Icon name={it.icon} size={20} />
							{it.title}
						</h3>
						<p set:html={it.body} />
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.split {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(40px, 8vw, 120px);
		align-items: start;
	}

	.side {
		position: sticky;
		top: 140px;
		display: grid;
		gap: 24px;
	}

	.list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--hair);
	}

	.list li {
		padding: 36px 0;
		border-bottom: 1px solid var(--hair);
	}

	h3 {
		display: flex;
		align-items: center;
		gap: 12px;
		margin: 0 0 12px;
		font-size: clamp(19px, 1.7vw, 22px);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	h3 :global(svg) {
		flex: none;
		color: var(--accent);
	}

	.list p {
		margin: 0 0 0 32px;
		max-width: 56ch;
		font-size: 15.5px;
		color: var(--fg-3);
		text-wrap: pretty;
	}

	.list p :global(code) {
		font-size: 0.88em;
		color: var(--fg-2);
	}

	@media (max-width: 960px) {
		.split {
			grid-template-columns: minmax(0, 1fr);
		}
		.side {
			position: static;
		}
		.list p {
			margin-left: 0;
		}
	}
</style>
