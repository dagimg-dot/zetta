---
import Icon from "./Icon.astro";
import { composeYaml, installCmd, links } from "../site";

const methods = [
	{
		id: "script",
		label: "Linux & macOS",
		code: installCmd,
		note: "Picks the build for your system, checks it against the release's SHA256SUMS and installs to /usr/local/bin, or ~/.local/bin when that is not writable. Set ZETTA_VERSION to pin a release.",
	},
	{
		id: "arch",
		label: "Arch Linux",
		code: "git clone --depth 1 https://github.com/dagimg-dot/zetta\ncd zetta/packaging/aur/zetta-bin && makepkg -si",
		note: "Builds the zetta-bin package from this repository, with bash, zsh and fish completions.",
	},
	{
		id: "docker",
		label: "Docker",
		code: 'export ZETTA_TOKEN=$(openssl rand -hex 16)\ndocker run --rm -p 127.0.0.1:1993:1993 -e ZETTA_TOKEN \\\n  -e DATABASE_URL=postgres://user:password@db:5432/app workflowjd/zetta',
		note: "A static binary on scratch for amd64 and arm64, also on ghcr.io/dagimg-dot/zetta. Open http://localhost:1993/?token=$ZETTA_TOKEN.",
	},
	{
		id: "compose",
		label: "Docker Compose",
		code: composeYaml.trimEnd(),
		note: "Put ZETTA_TOKEN in .env, run docker compose up, and open the link docker compose logs zetta prints. zetta waits up to 30 seconds for the database to start.",
	},
	{
		id: "source",
		label: "From source",
		code: "cd web && bun install && cd ..\nzig build -Doptimize=ReleaseSafe",
		note: "Needs Zig 0.16.0 and bun. The binary lands in zig-out/bin/zetta.",
	},
];

const platforms = [
	"macOS · Apple Silicon",
	"Linux · x86_64",
	"Linux · arm64",
	"Windows · x64",
	"Windows · arm64",
];
---

<section class="section" id="install">
	<div class="wrap">
		<div class="section-head center">
			<h2 class="h2 reveal">Install it in one line.</h2>
		</div>

		<div class="shell box reveal" style="--d:1">
			<div class="core">
				<div class="tabs" role="tablist" aria-label="Install method">
					{
						methods.map((m, i) => (
							<button
								role="tab"
								id={`tab-${m.id}`}
								aria-controls={`panel-${m.id}`}
								aria-selected={i === 0 ? "true" : "false"}
								data-method={m.id}
							>
								{m.label}
							</button>
						))
					}
				</div>
				{
					methods.map((m, i) => (
						<div
							class="panel"
							role="tabpanel"
							id={`panel-${m.id}`}
							aria-labelledby={`tab-${m.id}`}
							hidden={i !== 0}
						>
							<div class="code">
								<pre set:text={m.code} />
								<button class="copy" data-copy={m.code} aria-label={`Copy ${m.label} command`}>
									<Icon name="copy" size={16} class="i-copy" />
									<Icon name="check" size={16} class="i-check" />
								</button>
							</div>
							<p>{m.note}</p>
						</div>
					))
				}
			</div>
		</div>

		<div class="platforms reveal" style="--d:2">
			<span>Prebuilt for</span>
			<ul>
				{platforms.map((p) => <li>{p}</li>)}
			</ul>
			<a href={links.releases} target="_blank" rel="noopener" class="rel">
				All releases <Icon name="arrow" size={14} />
			</a>
		</div>
	</div>
</section>

<script>
	const root = document.querySelector<HTMLElement>("#install");
	const tabs = [...(root?.querySelectorAll<HTMLButtonElement>("[role=tab]") ?? [])];
	for (const t of tabs) {
		t.addEventListener("click", () => {
			for (const o of tabs) {
				const on = o === t;
				o.setAttribute("aria-selected", String(on));
				const panel = document.getElementById(o.getAttribute("aria-controls") ?? "");
				if (panel) panel.hidden = !on;
			}
		});
	}
</script>

<style>
	.box {
		max-width: 920px;
		margin-inline: auto;
	}

	.tabs {
		display: flex;
		gap: 4px;
		padding: 8px;
		border-bottom: 1px solid var(--hair);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.tabs button {
		flex: none;
		padding: 9px 18px;
		border-radius: 999px;
		font-size: 14px;
		color: var(--fg-3);
		transition:
			background-color 500ms var(--ease),
			color 500ms var(--ease);
	}

	.tabs button:hover {
		color: var(--fg);
	}

	.tabs button[aria-selected="true"] {
		background: var(--tint-2);
		box-shadow: inset 0 0 0 1px var(--hair-2);
		color: var(--fg);
	}

	.panel {
		padding: 24px;
		animation: rise 600ms var(--ease-out);
	}

	/* Commands read as a terminal, dark in either theme. */
	.code {
		position: relative;
		color-scheme: dark;
		border-radius: 14px;
		background: oklch(0.13 0.004 50);
		box-shadow: inset 0 0 0 1px var(--hair);
	}

	pre {
		margin: 0;
		padding: 22px 64px 22px 22px;
		font-size: 13.5px;
		line-height: 1.8;
		color: var(--fg);
		white-space: pre;
		overflow-x: auto;
	}

	.copy {
		position: absolute;
		top: 12px;
		right: 12px;
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border-radius: 10px;
		background: var(--tint-2);
		color: var(--fg-2);
		transition:
			background-color 400ms var(--ease),
			transform 400ms var(--ease);
	}

	.copy:hover {
		background: var(--hair-2);
		color: var(--fg);
	}

	.copy:active {
		transform: scale(0.92);
	}

	.panel p {
		margin: 18px 4px 0;
		font-size: 14.5px;
		color: var(--fg-3);
		max-width: 72ch;
	}

	.platforms {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 12px 16px;
		margin-top: 32px;
		font-size: 14px;
		color: var(--fg-3);
	}

	.platforms ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.platforms li {
		padding: 5px 12px;
		border-radius: 999px;
		box-shadow: inset 0 0 0 1px var(--hair);
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-2);
	}

	.rel {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--accent);
	}
</style>
