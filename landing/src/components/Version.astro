---
import { release } from "../site";

interface Props {
	class?: string;
}

const { class: cls } = Astro.props;
---

<span class:list={["version", cls]} data-version hidden={!release}>{release && `v${release}`}</span>

<script>
	/*
	 * The build fills every [data-version] with the release that was latest then. This checks
	 * GitHub for a newer one, and keeps the answer an hour to stay well inside the anonymous
	 * rate limit. Without a build-time tag the slots stay hidden until the answer arrives, so
	 * the page never shows a made-up number.
	 */
	const API = "https://api.github.com/repos/dagimg-dot/zetta/releases/latest";
	const KEY = "zetta-site.release";
	const TTL_MS = 60 * 60 * 1000;

	function cached(): string | null {
		try {
			const raw = JSON.parse(localStorage.getItem(KEY) ?? "null") as { tag?: unknown; at?: unknown } | null;
			if (typeof raw?.tag === "string" && typeof raw.at === "number" && Date.now() - raw.at < TTL_MS) {
				return raw.tag;
			}
		} catch {
			// Unreadable or blocked storage; fetch instead.
		}
		return null;
	}

	async function fetchTag(): Promise<string | null> {
		const res = await fetch(API, { headers: { Accept: "application/vnd.github+json" } });
		if (!res.ok) return null;
		const body = (await res.json()) as { tag_name?: unknown };
		if (typeof body.tag_name !== "string") return null;
		try {
			localStorage.setItem(KEY, JSON.stringify({ tag: body.tag_name, at: Date.now() }));
		} catch {
			// Storage can be blocked; the next visit fetches again.
		}
		return body.tag_name;
	}

	async function fill() {
		const slots = document.querySelectorAll<HTMLElement>("[data-version]");
		if (slots.length === 0) return;
		let tag = cached();
		if (!tag) {
			try {
				tag = await fetchTag();
			} catch {
				// Offline or blocked; the build-time tag, if any, stays.
				return;
			}
		}
		if (!tag) return;
		const label = `v${tag.replace(/^v/, "")}`;
		for (const el of slots) {
			if (el.textContent === label) continue;
			el.textContent = label;
			el.hidden = false;
		}
	}

	// Off the critical path: the tag is already in the page for almost every visit.
	const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 1));
	idle(() => void fill());
</script>

<style>
	.version:not([hidden]) {
		animation: rise 500ms var(--ease-out);
	}
</style>
