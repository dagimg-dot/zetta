---
import Screenshot from "./Screenshot.astro";
import { screens } from "../screens";

const engines = [
	{ id: "sqlite", name: "SQLite", ...screens.sqlite },
	{ id: "postgres", name: "Postgres", ...screens.postgres },
];
---

<section class="section engines" id="engines">
	<div class="wrap">
		<div class="section-head center">
			<h2 class="h2 reveal">Postgres or SQLite, the same interface.</h2>
			<div class="seg reveal" style="--d:1" role="tablist" aria-label="Database engine">
				<span class="thumb" aria-hidden="true"></span>
				{
					engines.map((e, i) => (
						<button role="tab" data-engine={e.id} aria-selected={i === 0 ? "true" : "false"}>
							{e.name}
						</button>
					))
				}
			</div>
		</div>

		<figure class="frame reveal" style="--d:2">
			<div class="shell">
				<div class="core stack">
					{
						engines.map((e, i) => (
							<div class:list={["pane", { on: i === 0 }]} data-engine={e.id}>
								<Screenshot light={e.light} dark={e.dark} alt={e.alt} class="shot" />
							</div>
						))
					}
				</div>
			</div>
			<figcaption class="stack">
				{
					engines.map((e, i) => (
						<span class:list={["pane", { on: i === 0 }]} data-engine={e.id}>
							{e.caption}
						</span>
					))
				}
			</figcaption>
		</figure>
	</div>
</section>

<script>
	const root = document.querySelector<HTMLElement>("#engines");
	const seg = root?.querySelector<HTMLElement>(".seg");
	const tabs = [...(root?.querySelectorAll<HTMLButtonElement>("[role=tab]") ?? [])];
	const panes = [...(root?.querySelectorAll<HTMLElement>(".pane") ?? [])];

	tabs.forEach((tab, i) => {
		tab.addEventListener("click", () => {
			for (const t of tabs) t.setAttribute("aria-selected", String(t === tab));
			seg?.style.setProperty("--x", String(i));
			for (const p of panes) p.classList.toggle("on", p.dataset.engine === tab.dataset.engine);
		});
	});
</script>

<style>
	.engines {
		padding-top: 0;
	}

	.seg {
		--x: 0;
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		padding: 5px;
		border-radius: 999px;
		background: var(--tint);
		box-shadow:
			inset 0 0 0 1px var(--hair-2),
			inset 0 1px 0 var(--highlight);
	}

	.thumb {
		position: absolute;
		inset: 5px auto 5px 5px;
		width: calc(50% - 5px);
		border-radius: 999px;
		background: var(--fg);
		transform: translateX(calc(var(--x) * 100%));
		transition: transform 700ms var(--ease);
	}

	.seg button {
		position: relative;
		min-width: 130px;
		padding: 10px 24px;
		border-radius: 999px;
		font-size: 15px;
		color: var(--fg-2);
		transition: color 600ms var(--ease);
	}

	.seg button[aria-selected="true"] {
		color: var(--bg);
		font-weight: 500;
	}

	.frame {
		max-width: 1200px;
		margin: 0 auto;
	}

	.frame .shell {
		--r-xl: 22px;
		--bezel: 7px;
	}

	/* Both engines sit in one grid cell and cross-fade. */
	.stack {
		display: grid;
	}

	.pane {
		grid-area: 1 / 1;
		opacity: 0;
		transition: opacity 800ms var(--ease);
	}

	.pane.on {
		opacity: 1;
	}

	.frame :global(.shot) {
		width: 100%;
		height: auto;
	}

	figcaption {
		margin-top: 20px;
		text-align: center;
		font-size: 14px;
		color: var(--fg-3);
	}
</style>
