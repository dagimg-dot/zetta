---
import { faq } from "../site";
---

<section class="section" id="faq">
	<div class="wrap split">
		<div class="side">
			<h2 class="h2 reveal">Questions, answered.</h2>
			<p class="lede reveal" style="--d:1">
				Anything else, ask in the <a href="https://github.com/dagimg-dot/zetta/issues">issue tracker</a>.
			</p>
		</div>

		<div class="list">
			{
				faq.map((f, i) => (
					<details class="reveal" style={`--d:${Math.min(i, 3)}`} open={i === 0}>
						<summary>
							<h3>{f.q}</h3>
							<span class="mark" aria-hidden="true" />
						</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.split {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(40px, 8vw, 120px);
		align-items: start;
	}

	.side {
		position: sticky;
		top: 140px;
		display: grid;
		gap: 24px;
	}

	.lede a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.list {
		border-top: 1px solid var(--hair);
	}

	details {
		border-bottom: 1px solid var(--hair);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 24px 0;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	h3 {
		margin: 0;
		font-size: clamp(17px, 1.5vw, 20px);
		font-weight: 500;
		letter-spacing: -0.025em;
		transition: color 400ms var(--ease);
	}

	summary:hover h3 {
		color: var(--accent);
	}

	/* A plus that turns into a minus. */
	.mark {
		position: relative;
		flex: none;
		width: 28px;
		height: 28px;
		border-radius: 999px;
		background: var(--tint);
		box-shadow: inset 0 0 0 1px var(--hair);
	}

	.mark::before,
	.mark::after {
		content: "";
		position: absolute;
		left: 50%;
		top: 50%;
		width: 11px;
		height: 1.5px;
		margin: -0.75px 0 0 -5.5px;
		border-radius: 2px;
		background: var(--fg-2);
		transition: transform 500ms var(--ease);
	}

	.mark::after {
		transform: rotate(90deg);
	}

	details[open] .mark::after {
		transform: rotate(0deg);
	}

	details p {
		margin: 0;
		padding: 0 52px 28px 0;
		max-width: 68ch;
		font-size: 15.5px;
		color: var(--fg-3);
		text-wrap: pretty;
	}

	details[open] p {
		animation: rise 500ms var(--ease-out);
	}

	@media (max-width: 960px) {
		.split {
			grid-template-columns: minmax(0, 1fr);
		}
		.side {
			position: static;
		}
		details p {
			padding-right: 0;
		}
	}
</style>
