---
import { Font } from "astro:assets";
import "../styles/global.css";
import { meta } from "../site";

interface Props {
	title: string;
	description: string;
	/** Structured data for this page, as schema.org objects that join one @graph. */
	schema?: Record<string, unknown>[];
	noindex?: boolean;
}

const { title, description, schema = [], noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://tryzetta.netlify.app");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(meta.ogImage, site).href;
const ld = schema.length
	? JSON.stringify({ "@context": "https://schema.org", "@graph": schema }).replace(/</g, "\\u003c")
	: null;
---

<!doctype html>
<html lang="en" class="no-js">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#faf8f6" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f0d0c" media="(prefers-color-scheme: dark)" />

		<script is:inline>
			document.documentElement.classList.remove("no-js");
			try {
				const t = localStorage.getItem("zetta-site.theme");
				if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
			} catch {
				// Storage can be blocked; the page then follows the OS.
			}
		</script>

		<Font cssVariable="--font-lexend" preload />
		<Font cssVariable="--font-instrument" preload />
		<Font cssVariable="--font-code" />
		<link rel="preconnect" href="https://api.github.com" crossorigin />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="zetta for language models" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={meta.name} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={meta.ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={meta.ogImageAlt} />
		{ld && <script type="application/ld+json" set:html={ld} />}
	</head>
	<body>
		<slot />
		<script>
			/*
			 * Screenshots show the app in the opposite theme to the page. Their <source> follows
			 * the OS; when [data-theme] overrides it, pin the source on or off to match.
			 */
			const root = document.documentElement;
			const syncShots = () => {
				const t = root.dataset.theme;
				const media = t === "dark" ? "all" : t === "light" ? "not all" : "(prefers-color-scheme: dark)";
				for (const s of document.querySelectorAll<HTMLSourceElement>("source[data-dark-page]")) {
					if (s.media !== media) s.media = media;
				}
			};
			syncShots();
			new MutationObserver(syncShots).observe(root, { attributes: true, attributeFilter: ["data-theme"] });

			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (!e.isIntersecting) continue;
						e.target.classList.add("in");
						io.unobserve(e.target);
					}
				},
				{ rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
			);
			for (const el of document.querySelectorAll(".reveal")) io.observe(el);

			for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
				btn.addEventListener("click", async () => {
					try {
						await navigator.clipboard.writeText(btn.dataset.copy ?? "");
					} catch {
						// Clipboard access was refused; the button simply does not confirm.
						return;
					}
					btn.dataset.copied = "";
					setTimeout(() => delete btn.dataset.copied, 1600);
				});
			}
		</script>
	</body>
</html>
